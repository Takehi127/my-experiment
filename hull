<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Frutiger Aero Interactive Experience</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Tone.js for high-quality synthetic sound generation without external asset URLs -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
  <!-- Font-Awesome for vector icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Comfortaa:wght@400;700&family=Noto+Sans+JP:wght@100;300;500;700&display=swap');

    :root {
      --aero-blue: rgba(14, 165, 233, 0.45);
      --aero-green: rgba(34, 197, 94, 0.45);
    }

    body {
      font-family: 'Comfortaa', 'Noto Sans JP', sans-serif;
      overflow: hidden;
      user-select: none;
      background: linear-gradient(135deg, #022c22 0%, #0369a1 40%, #0e7490 70%, #15803d 100%);
      height: 100vh;
      width: 100vw;
    }

    /* Aero Glass Styling - The core visual hallmark of Frutiger Aero */
    .aero-glass {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0.1) 100%);
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      border: 1px solid rgba(255, 255, 255, 0.6);
      box-shadow: 
        0 8px 32px 0 rgba(0, 0, 0, 0.15),
        inset 0 1px 0 rgba(255, 255, 255, 0.8),
        inset 0 -10px 20px rgba(255, 255, 255, 0.1);
      text-shadow: 0 1px 2px rgba(255, 255, 255, 0.5);
    }

    /* Highlight glossy overlay */
    .glossy-reflection {
      position: relative;
      overflow: hidden;
    }
    .glossy-reflection::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 50%;
      background: linear-gradient(to bottom, rgba(255, 255, 255, 0.45) 0%, rgba(255, 255, 255, 0) 100%);
      pointer-events: none;
      z-index: 1;
    }

    /* Frutiger Aero Aurora Waves */
    .aurora-bg {
      position: absolute;
      width: 200%;
      height: 200%;
      top: -50%;
      left: -50%;
      background: 
        radial-gradient(circle at 30% 20%, rgba(56, 189, 248, 0.4) 0%, transparent 40%),
        radial-gradient(circle at 80% 40%, rgba(74, 222, 128, 0.35) 0%, transparent 45%),
        radial-gradient(circle at 40% 80%, rgba(14, 165, 233, 0.3) 0%, transparent 50%),
        radial-gradient(circle at 90% 10%, rgba(16, 185, 129, 0.25) 0%, transparent 35%);
      filter: blur(80px);
      animation: auroraRotate 40s linear infinite;
      z-index: 0;
      pointer-events: none;
    }

    @keyframes auroraRotate {
      0% { transform: rotate(0deg) scale(1); }
      50% { transform: rotate(180deg) scale(1.15); }
      100% { transform: rotate(360deg) scale(1); }
    }

    /* Vector Streamlines for Frutiger Aero flow */
    .streamline {
      position: absolute;
      border-radius: 50%;
      border-top: 4px solid rgba(255, 255, 255, 0.15);
      border-left: 2px solid rgba(255, 255, 255, 0.05);
      filter: blur(2px);
      pointer-events: none;
      transform: rotate(-15deg);
      animation: waveFlow 25s ease-in-out infinite;
    }

    @keyframes waveFlow {
      0%, 100% { transform: translateY(0) rotate(-15deg) scaleY(1); }
      50% { transform: translateY(-30px) rotate(-10deg) scaleY(1.1); }
    }

    /* Wet glossy water drop on desktop */
    .water-droplet {
      position: absolute;
      background: radial-gradient(circle at 35% 35%, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.15) 50%, rgba(0, 0, 0, 0.1) 80%, rgba(0, 0, 0, 0.25) 100%);
      box-shadow: 
        inset -2px -2px 6px rgba(0, 0, 0, 0.3),
        inset 2px 2px 6px rgba(255, 255, 255, 0.8),
        2px 6px 12px rgba(0, 0, 0, 0.15);
      border-radius: 50% 50% 55% 45% / 55% 55% 45% 45%;
      pointer-events: auto;
      cursor: pointer;
      transition: transform 0.1s ease;
    }
    .water-droplet:hover {
      transform: scale(1.08);
    }
    .water-droplet:active {
      transform: scale(0.9);
    }

    /* Lucid Dream Floating Bubble Styles */
    .escape-bubble {
      position: absolute;
      bottom: -60px;
      border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.6) 0%, rgba(255, 255, 255, 0.1) 60%, rgba(14, 165, 233, 0.25) 80%, rgba(255, 255, 255, 0) 100%);
      box-shadow: 
        inset 0 0 10px rgba(255, 255, 255, 0.6),
        0 4px 12px rgba(14, 165, 233, 0.1);
      border: 0.5px solid rgba(255, 255, 255, 0.35);
      pointer-events: none;
      animation: floatUpAndAway 9s linear forwards;
    }

    @keyframes floatUpAndAway {
      0% {
        transform: translateY(0) translateX(0) scale(1);
        opacity: 0;
      }
      10% {
        opacity: 0.75;
      }
      90% {
        opacity: 0.75;
      }
      100% {
        transform: translateY(-115vh) translateX(var(--wobble-x)) scale(1.1);
        opacity: 0;
      }
    }
  </style>
</head>
<body class="relative flex flex-col justify-between select-none w-screen h-screen">

  <!-- Ambient Aurora and Water flow overlays -->
  <div class="aurora-bg"></div>
  
  <!-- Curved organic lines representing 2000s vector line-art -->
  <div class="streamline w-[140vw] h-[60vh] -top-10 -left-20 opacity-30"></div>
  <div class="streamline w-[120vw] h-[50vh] top-1/3 -left-10 opacity-20" style="animation-delay: -5s; animation-duration: 35s;"></div>
  <div class="streamline w-[150vw] h-[40vh] -bottom-20 -left-10 opacity-40" style="animation-delay: -12s; animation-duration: 18s;"></div>

  <!-- Main Water Ripple Effect Canvas (Shared across screens) -->
  <canvas id="rippleCanvas" class="absolute inset-0 w-full h-full z-1 pointer-events-none"></canvas>

  <!-- ==================== HOME SCREEN ==================== -->
  <div id="homeScreen" class="absolute inset-0 z-20 flex flex-col items-center justify-center p-6 transition-all duration-1000">
    <div class="aero-glass rounded-3xl p-8 max-w-lg w-full text-center glossy-reflection flex flex-col items-center gap-6 border-2 border-white/70 shadow-2xl">
      <!-- Glossy Orb logo in center -->
      <div class="w-20 h-20 rounded-full bg-gradient-to-tr from-sky-500 via-emerald-400 to-white flex items-center justify-center shadow-xl border-2 border-white relative overflow-hidden group">
        <div class="absolute inset-0 bg-gradient-to-b from-white/70 to-transparent h-[45%] rounded-b-full"></div>
        <i class="fa-solid fa-leaf text-white text-3xl drop-shadow-md animate-pulse"></i>
      </div>
      <div>
        <h1 class="text-white text-2xl font-bold tracking-widest drop-shadow-sm uppercase">Aero Dreamspace</h1>
        <p class="text-xs text-sky-100 mt-2 tracking-wide">持続可能な未来と、穏やかな夢のインターフェース</p>
      </div>

      <p class="text-xs text-slate-100 leading-relaxed max-w-sm px-2 opacity-90">
        ガラスの艶、水の清らかさ、および輝く新緑。優しく満ち溢れる2000年代中頃の楽観主義へ、もう一度アクセスしましょう。
      </p>

      <!-- Glassy Start Button with ripple triggers -->
      <button onclick="enterDream()" class="w-full py-4 bg-gradient-to-r from-emerald-400/50 to-sky-400/50 hover:from-emerald-400/70 hover:to-sky-400/70 active:scale-95 border-2 border-white/80 rounded-2xl text-white font-bold tracking-widest text-sm transition-all shadow-lg glossy-reflection">
        <i class="fa-solid fa-eye mr-2"></i> 夢を見る
      </button>
    </div>
  </div>


  <!-- ==================== STREAMING_CHUNK:Rendering main workspace simulator interface... ==================== -->
  <!-- ==================== GAME/SIMULATOR SCREEN ==================== -->
  <div id="gameScreen" class="absolute inset-0 z-10 flex flex-col justify-between transition-all duration-1000 translate-y-10 opacity-0 pointer-events-none pb-6">
    
    <!-- Top Aero Navigation Header Bar -->
    <header class="w-full h-16 px-6 flex items-center justify-between aero-glass glossy-reflection z-10">
      <div class="flex items-center gap-3">
        <!-- Glossy Orb Logo resembling Windows Vista style Orb -->
        <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-sky-500 via-emerald-400 to-white flex items-center justify-center shadow-lg border border-white/60 relative overflow-hidden group cursor-pointer" onclick="playAeroChime()">
          <div class="absolute inset-0 bg-gradient-to-b from-white/60 to-transparent h-[45%] rounded-b-full"></div>
          <i class="fa-solid fa-leaf text-white text-base drop-shadow-md group-hover:rotate-12 transition-transform duration-300"></i>
        </div>
        <div>
          <h1 class="text-white font-bold text-sm tracking-widest drop-shadow-sm">AERO ECO-SYSTEM</h1>
          <p class="text-[10px] text-sky-100 opacity-95">Frutiger Aero Desktop v1.3</p>
        </div>
      </div>

      <!-- Active Environmental Status Indicators -->
      <div class="hidden md:flex items-center gap-6">
        <div class="flex items-center gap-2 bg-white/20 px-3 py-1.5 rounded-full border border-white/40 text-xs text-white">
          <i class="fa-solid fa-wind text-sky-200 animate-pulse"></i>
          <span>空気清浄: <strong class="font-bold">98%</strong></span>
        </div>
        <div class="flex items-center gap-2 bg-white/20 px-3 py-1.5 rounded-full border border-white/40 text-xs text-white">
          <i class="fa-solid fa-seedling text-emerald-300 animate-bounce" style="animation-duration: 3s"></i>
          <span>自然共生率: <strong class="font-bold">85%</strong></span>
        </div>
        <div class="flex items-center gap-2 bg-white/20 px-3 py-1.5 rounded-full border border-white/40 text-xs text-white">
          <i class="fa-solid fa-droplet text-blue-200"></i>
          <span>循環水質: <strong class="font-bold">純水</strong></span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <!-- Sound toggle button with gloss effect -->
        <button onclick="toggleMute()" id="muteBtn" class="w-9 h-9 rounded-full bg-white/20 border border-white/50 text-white flex items-center justify-center hover:bg-white/40 transition-all shadow-md relative overflow-hidden glossy-reflection">
          <i class="fa-solid fa-volume-high" id="muteIcon"></i>
        </button>
        <div class="text-right text-xs text-white">
          <p class="font-bold" id="currentTime">12:00 PM</p>
          <p class="text-[9px] text-sky-200" id="currentDate">2010.07.12</p>
        </div>
      </div>
    </header>

    <!-- Main Grid Workspace -->
    <main class="flex-grow w-full px-6 py-6 z-10 flex flex-col lg:flex-row gap-6 items-start overflow-hidden relative">
      
      <!-- LEFT PANEL: Ecosystem Simulation Control Center -->
      <section class="w-full lg:w-5/12 h-full flex flex-col gap-6 overflow-y-auto pr-1">
        
        <!-- Eco Ecosystem Card with Aero Style Tabs -->
        <div class="aero-glass rounded-2xl p-5 glossy-reflection flex flex-col gap-4 relative">
          <div class="absolute -right-3 -top-3 w-16 h-16 bg-emerald-400/20 blur-xl pointer-events-none"></div>
          <div class="flex justify-between items-center">
            <h2 class="font-bold text-white text-base flex items-center gap-2">
              <i class="fa-solid fa-globe text-emerald-300"></i>
              自然科学プラザ & 環境調整
            </h2>
            <span class="text-[10px] bg-emerald-400/30 text-white px-2 py-0.5 rounded-full border border-emerald-300/40">ONLINE</span>
          </div>
          
          <p class="text-xs text-sky-50 line-clamp-2">
            太陽光・バイオ・水資源テクノロジーを調和させ、楽観的で持続可能なフューチャー・オアシスを構築します。パネルをクリックしてシステム出力を上昇させましょう。
          </p>

          <!-- Dynamic Energy Progress Bars -->
          <div class="space-y-3">
            <div>
              <div class="flex justify-between text-[11px] text-white mb-1">
                <span><i class="fa-solid fa-solar-panel mr-1 text-amber-300"></i> 太陽エネルギー効率</span>
                <span id="solarVal">72%</span>
              </div>
              <div class="w-full bg-black/15 h-3 rounded-full overflow-hidden border border-white/20 p-[1px]">
                <div id="solarBar" class="bg-gradient-to-r from-amber-400 to-emerald-400 h-full rounded-full transition-all duration-500 shadow-inner" style="width: 72%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between text-[11px] text-white mb-1">
                <span><i class="fa-solid fa-water mr-1 text-sky-300"></i> 水素バイオ燃料セル</span>
                <span id="bioVal">55%</span>
              </div>
              <div class="w-full bg-black/15 h-3 rounded-full overflow-hidden border border-white/20 p-[1px]">
                <div id="bioBar" class="bg-gradient-to-r from-sky-400 to-teal-400 h-full rounded-full transition-all duration-500 shadow-inner" style="width: 55%"></div>
              </div>
            </div>
          </div>

          <!-- System interaction buttons with shiny hover effect -->
          <div class="grid grid-cols-2 gap-3 mt-1">
            <button onclick="boostSystem('solar')" class="py-2 px-3 bg-white/20 hover:bg-white/35 active:scale-95 border border-white/50 text-white rounded-xl text-xs font-semibold flex items-center justify-center gap-2 transition-all shadow-sm glossy-reflection">
              <i class="fa-solid fa-bolt text-amber-300"></i> 光合成ソーラー強化
            </button>
            <button onclick="boostSystem('bio')" class="py-2 px-3 bg-white/20 hover:bg-white/35 active:scale-95 border border-white/50 text-white rounded-xl text-xs font-semibold flex items-center justify-center gap-2 transition-all shadow-sm glossy-reflection">
              <i class="fa-solid fa-flask text-sky-300"></i> 水素バイオ液循環
            </button>
          </div>
        </div>

        <!-- Interactive Aero Media Player - Reminiscent of Windows Media Player 11/12 -->
        <div class="aero-glass rounded-2xl p-5 glossy-reflection flex flex-col gap-3 relative">
          <div class="flex items-center justify-between border-b border-white/20 pb-2">
            <h3 class="text-white font-bold text-xs flex items-center gap-2">
              <i class="fa-solid fa-compact-disc animate-spin text-sky-200" style="animation-duration: 6s"></i>
              AERO SYNTH AUDIO - 水のワルツ
            </h3>
            <span class="text-[9px] text-sky-100 font-mono" id="playerTime">0:00 / 0:30</span>
          </div>

          <!-- Glassy Visualizer area simulating waves -->
          <div class="h-16 bg-slate-900/10 rounded-xl border border-white/20 flex items-end justify-between p-2 overflow-hidden gap-1 relative">
            <!-- Ambient overlay for depth -->
            <div class="absolute inset-0 bg-gradient-to-t from-sky-400/10 to-transparent pointer-events-none"></div>
            <!-- Animated equalizer bars -->
            <div class="eq-bar w-full bg-emerald-400/60 rounded-t-sm transition-all duration-200" style="height: 10%"></div>
            <div class="eq-bar w-full bg-sky-300/60 rounded-t-sm transition-all duration-200" style="height: 30%"></div>
            <div class="eq-bar w-full bg-sky-400/60 rounded-t-sm transition-all duration-200" style="height: 50%"></div>
            <div class="eq-bar w-full bg-teal-300/60 rounded-t-sm transition-all duration-200" style="height: 20%"></div>
            <div class="eq-bar w-full bg-emerald-300/60 rounded-t-sm transition-all duration-200" style="height: 60%"></div>
            <div class="eq-bar w-full bg-sky-300/60 rounded-t-sm transition-all duration-200" style="height: 80%"></div>
            <div class="eq-bar w-full bg-cyan-300/60 rounded-t-sm transition-all duration-200" style="height: 40%"></div>
            <div class="eq-bar w-full bg-teal-400/60 rounded-t-sm transition-all duration-200" style="height: 15%"></div>
            <div class="eq-bar w-full bg-sky-400/60 rounded-t-sm transition-all duration-200" style="height: 70%"></div>
            <div class="eq-bar w-full bg-emerald-400/60 rounded-t-sm transition-all duration-200" style="height: 35%"></div>
          </div>

          <!-- Music Controls with glossy glass buttons -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <button onclick="playMusicTrack()" id="playBtn" class="w-10 h-10 rounded-full bg-sky-400/30 hover:bg-sky-400/50 text-white flex items-center justify-center border border-white/60 shadow-md glossy-reflection transition-all">
                <i class="fa-solid fa-play text-xs pl-0.5" id="playIcon"></i>
              </button>
              <button onclick="stopMusicTrack()" class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center border border-white/40 shadow-sm transition-all">
                <i class="fa-solid fa-stop text-xs"></i>
              </button>
            </div>
            
            <div class="text-right text-[10px] text-sky-100">
              <p id="audioStatus">オーディオ合成エンジン待機中</p>
              <p class="text-[9px] opacity-75">※ Web Audio APIによりシンセサイザー音を直接自動生成</p>
            </div>
          </div>
        </div>

        <!-- Info Capsule - Aero design glossary -->
        <div class="aero-glass rounded-2xl p-5 glossy-reflection flex flex-col gap-3">
          <h3 class="text-white font-bold text-xs flex items-center gap-2 border-b border-white/20 pb-2">
            <i class="fa-solid fa-circle-info text-sky-200"></i>
            フルティガーエアロとは？
          </h3>
          <p class="text-xs text-slate-100 leading-relaxed space-y-1">
            2000年代中頃から2010年代初頭のデジタル・ガジェットやOSに広く使われた美学。
            「明るく持続可能な未来」「エコテクノロジー」「水・草花・青空といった地球本来の瑞々しさ」を高次元で融合した、人類史における最も前向きで楽観的なデザイン様式です。
          </p>
          <div class="flex flex-wrap gap-1.5 mt-1">
            <span class="text-[9px] bg-white/20 text-sky-100 px-2 py-0.5 rounded-full border border-white/20">#透明感</span>
            <span class="text-[9px] bg-white/20 text-sky-100 px-2 py-0.5 rounded-full border border-white/20">#水滴</span>
            <span class="text-[9px] bg-white/20 text-sky-100 px-2 py-0.5 rounded-full border border-white/20">#流線型</span>
            <span class="text-[9px] bg-white/20 text-sky-100 px-2 py-0.5 rounded-full border border-white/20">#2010年代ノスタルジー</span>
          </div>
        </div>

      </section>

      <!-- RIGHT PANEL: Glass Aquatic Oasis Simulation & Interaction -->
      <section class="w-full lg:w-7/12 h-full flex flex-col gap-4 relative justify-between">
        
        <!-- Eco Ecosystem Canvas Display Panel -->
        <div class="w-full h-[52vh] min-h-[300px] aero-glass rounded-3xl relative overflow-hidden flex flex-col justify-between p-6 glossy-reflection border-2 border-white/60">
          
          <!-- Aquatic Sun Rays Background Overlay -->
          <div class="absolute inset-0 bg-gradient-to-b from-sky-300/25 via-emerald-300/10 to-transparent pointer-events-none mix-blend-screen z-1"></div>
          <div class="absolute inset-x-0 top-0 h-40 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-white/30 via-white/5 to-transparent pointer-events-none z-1"></div>

          <!-- Custom Canvas rendering ecological creatures and dynamic leaves/bubbles -->
          <canvas id="aquaticCanvas" class="absolute inset-0 w-full h-full z-0"></canvas>

          <!-- Glass Panel Header Overlay -->
          <div class="w-full flex justify-between items-start z-10 pointer-events-none">
            <div class="bg-white/20 backdrop-blur-md border border-white/50 rounded-2xl px-4 py-2 flex items-center gap-3 shadow-md pointer-events-auto">
              <div class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></div>
              <div>
                <p class="text-[11px] font-bold text-white leading-none">エコ・アクアテラリウム</p>
                <p class="text-[9px] text-sky-100">画面クリックで水滴波紋と炭酸泡の生成</p>
              </div>
            </div>

            <div class="flex gap-2">
              <button onclick="spawnBubbleWave()" class="bg-white/20 backdrop-blur-md border border-white/50 rounded-2xl px-3 py-1.5 shadow-md hover:bg-white/35 active:scale-95 transition-all text-white text-xs flex items-center gap-1.5 pointer-events-auto glossy-reflection">
                <i class="fa-solid fa-soap text-sky-200"></i> 泡の波を発生
              </button>
              <button onclick="addEcofish()" class="bg-white/20 backdrop-blur-md border border-white/50 rounded-2xl px-3 py-1.5 shadow-md hover:bg-white/35 active:scale-95 transition-all text-white text-xs flex items-center gap-1.5 pointer-events-auto glossy-reflection">
                <i class="fa-solid fa-fish text-sky-100"></i> デジタル魚追加
              </button>
            </div>
          </div>

          <!-- Natural Leaf Falling Interactive Zone -->
          <div id="natureContainer" class="absolute inset-0 pointer-events-none z-2"></div>

          <!-- Glass Panel Footer Info Overlay -->
          <div class="w-full flex justify-between items-end z-10">
            <div class="bg-black/15 backdrop-blur-md border border-white/30 rounded-2xl px-4 py-2 text-white shadow-md">
              <p class="text-[10px] text-emerald-200 font-bold uppercase tracking-wider">ECO POWER SOURCE</p>
              <div class="flex items-center gap-3 mt-0.5">
                <div class="flex items-center gap-1 text-xs">
                  <i class="fa-solid fa-shrub text-emerald-300"></i>
                  <span id="plantCountDisplay">植物: 15株</span>
                </div>
                <span class="text-white/40">|</span>
                <div class="flex items-center gap-1 text-xs">
                  <i class="fa-solid fa-fish text-sky-300"></i>
                  <span id="fishCountDisplay">デジタル魚: 3匹</span>
                </div>
              </div>
            </div>

            <!-- Glossy Seedling button to simulate gardening -->
            <button onclick="feedPlantation()" class="w-14 h-14 rounded-full bg-gradient-to-tr from-emerald-500 via-emerald-300 to-white hover:rotate-12 active:scale-90 flex items-center justify-center border-2 border-white text-white shadow-lg transition-all glossy-reflection relative group">
              <div class="absolute inset-0 bg-gradient-to-b from-white/60 to-transparent h-[45%] rounded-b-full"></div>
              <i class="fa-solid fa-seedling text-xl drop-shadow"></i>
            </button>
          </div>

        </div>

        <!-- Interactive Miniature Aero Control Deck (Bottom Widget Bar - Restored layout) -->
        <div class="w-full bg-white/10 border border-white/40 rounded-2xl p-4 flex flex-col md:flex-row items-center justify-between gap-4 glossy-reflection">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-sky-400 to-emerald-400 flex items-center justify-center text-white border border-white/50 relative overflow-hidden">
              <div class="absolute inset-0 bg-gradient-to-b from-white/50 to-transparent h-[45%] rounded-b-full"></div>
              <i class="fa-solid fa-spray-can text-lg"></i>
            </div>
            <div>
