  <script>
    // Global parameters
    let isMuted = false;
    let audioInitialized = false;

    // Synths & Sound Sources
    let polonSynth = null;     // New echoed polon sound
    let polonDelay = null;

    // Frutiger Aero BGM Synths (Waiting-inspired original track elements)
    let faPadSynth = null;
    let faArpSynth = null;
    let faBellSynth = null;
    let faTickSynth = null;
    let faBgmLoop = null;

    // Aquatic organisms and elements status
    let solarProgress = 72;
    let bioProgress = 55;
    let plantCount = 15;
    let fishes = [];

    // Screen State
    let isLucidDreamActive = false;

    // Set Clock and Date
    function updateClock() {
      const now = new Date();
      let hours = now.getHours();
      const minutes = now.getMinutes().toString().padStart(2, '0');
      const ampm = hours >= 12 ? 'PM' : 'AM';
      hours = hours % 12;
      hours = hours ? hours : 12; // 0 hour is 12
      document.getElementById('currentTime').innerText = `${hours}:${minutes} ${ampm}`;
      
      const year = now.getFullYear();
      const month = (now.getMonth() + 1).toString().padStart(2, '0');
      const date = now.getDate().toString().padStart(2, '0');
      document.getElementById('currentDate').innerText = `${year}.${month}.${date}`;
    }
    setInterval(updateClock, 1000);
    updateClock();

    // Ripple Effect Logic on Background
    const rippleCanvas = document.getElementById('rippleCanvas');
    const rx = rippleCanvas.getContext('2d');
    let width = rippleCanvas.width = window.innerWidth || 1;
    let height = rippleCanvas.height = window.innerHeight || 1;

    let rippleMap = [];
    let lastMap = [];
    let size = width * height;
    const damping = 0.98;

    // Reset Ripple Maps with safety checks
    function initRippleMap() {
      width = rippleCanvas.width = window.innerWidth || 1;
      height = rippleCanvas.height = window.innerHeight || 1;
      size = width * height;
      
      if (width <= 0 || height <= 0 || size <= 0) return;
      
      rippleMap = new Array(size).fill(0);
      lastMap = new Array(size).fill(0);
    }
    initRippleMap();

    window.addEventListener('resize', () => {
      initRippleMap();
    });

    // Create a Ripple at coordinates
    function ripple(x, y, rStrength) {
      if (width <= 0 || height <= 0) return;
      x = Math.floor(x);
      y = Math.floor(y);
      if (x < 1 || x >= width - 1 || y < 1 || y >= height - 1) return;
      
      const index = x + y * width;
      if (index >= 0 && index < size) {
        rippleMap[index] = rStrength;
      }
    }

    // Update simulation and render ripple to canvas with IndexSizeError guards
    function updateRipple() {
      if (width <= 1 || height <= 1 || size <= 1 || !rx) return;
      
      try {
        const imgData = rx.getImageData(0, 0, width, height);
        const data = imgData.data;

        // Calculate wave formula
        for (let i = width; i < size - width; i++) {
          rippleMap[i] = (
            (lastMap[i - 1] + 
             lastMap[i + 1] + 
             lastMap[i - width] + 
             lastMap[i + width]) >> 1
          ) - rippleMap[i];

          rippleMap[i] = Math.floor(rippleMap[i] * damping);
        }

        // Map waves to pixel intensity (Refraction approximation)
        for (let i = 0; i < size; i++) {
          const value = rippleMap[i];
          if (value !== 0) {
            const index = i * 4;
            if (index + 2 < data.length) {
              data[index] += value;     // R
              data[index + 1] += value; // G
              data[index + 2] += value; // B
            }
          }
        }

        // Swap buffer arrays
        const temp = lastMap;
        lastMap = rippleMap;
        rippleMap = temp;

        rx.putImageData(imgData, 0, 0);
      } catch (e) {
        // Safe bypass
      }
    }

    // Canvas Aquatic Aquarium Rendering Logic
    const aqCanvas = document.getElementById('aquaticCanvas');
    const ctx = aqCanvas.getContext('2d');
    let aqWidth = aqCanvas.width = aqCanvas.parentNode ? (aqCanvas.parentNode.clientWidth || 1) : 1;
    let aqHeight = aqCanvas.height = aqCanvas.parentNode ? (aqCanvas.parentNode.clientHeight || 1) : 1;

    window.addEventListener('resize', () => {
      if (aqCanvas.parentNode) {
        aqWidth = aqCanvas.width = aqCanvas.parentNode.clientWidth || 1;
        aqHeight = aqCanvas.height = aqCanvas.parentNode.clientHeight || 1;
      }
    });

    // Fish Definition
    class EcoFish {
      constructor() {
        this.color1 = Math.random() > 0.5 ? '#38bdf8' : '#22c55e';
        this.color2 = '#ffffff';
        this.size = 12 + Math.random() * 8;
        this.reset();
      }

      reset() {
        this.x = -20;
        this.y = Math.random() * (aqHeight > 0 ? aqHeight : 300);
        this.vx = 0.8 + Math.random() * 1.5;
        this.vy = (Math.random() - 0.5) * 0.4;
        this.tailAngle = 0;
        this.tailSpeed = 0.08 + Math.random() * 0.08;
      }

      update() {
        this.x += this.vx;
        this.y += this.vy;
        this.tailAngle += this.tailSpeed;
        
        // Randomly drift slightly vertically
        if (Math.random() < 0.02) {
          this.vy = (Math.random() - 0.5) * 0.6;
        }

        // Loop screen
        if (this.x > aqWidth + 30) {
          this.reset();
        }
      }

      draw() {
        if (aqWidth <= 1 || aqHeight <= 1) return;
        ctx.save();
        ctx.translate(this.x, this.y);
        ctx.shadowBlur = 10;
        ctx.shadowColor = this.color1;

        // Draw glossy streamline fish body
        ctx.beginPath();
        ctx.ellipse(0, 0, this.size, this.size / 2.2, 0, 0, Math.PI * 2);
        const gradient = ctx.createLinearGradient(-this.size, 0, this.size, 0);
        gradient.addColorStop(0, this.color1);
        gradient.addColorStop(0.6, this.color2);
        gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');
        ctx.fillStyle = gradient;
        ctx.fill();

        // Draw delicate tail fin moving back and forth
        const tailOffset = Math.sin(this.tailAngle) * (this.size * 0.4);
        ctx.beginPath();
        ctx.moveTo(-this.size, 0);
        ctx.quadraticCurveTo(-this.size * 1.5, -this.size / 2 + tailOffset, -this.size * 1.8, -this.size * 0.8 + tailOffset);
        ctx.lineTo(-this.size * 1.6, tailOffset);
        ctx.lineTo(-this.size * 1.8, this.size * 0.8 + tailOffset);
        ctx.quadraticCurveTo(-this.size * 1.5, this.size / 2 + tailOffset, -this.size, 0);
        ctx.fillStyle = this.color1;
        ctx.fill();

        // Gloss highlight
        ctx.beginPath();
        ctx.ellipse(this.size * 0.1, -this.size * 0.1, this.size * 0.6, this.size * 0.12, 0, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255, 255, 255, 0.7)';
        ctx.fill();

        // Eye
        ctx.beginPath();
        ctx.arc(this.size * 0.5, -this.size * 0.1, 2, 0, Math.PI * 2);
        ctx.fillStyle = '#ffffff';
        ctx.fill();

        ctx.restore();
      }
    }

    // Spawn Initial fishes
    for (let i = 0; i < 3; i++) {
      fishes.push(new EcoFish());
    }

    // Dynamic bubble arrays inside aquarium container
    let aqBubbles = [];
    class AqBubble {
      constructor(x, y, speed, size) {
        this.x = x || Math.random() * aqWidth;
        this.y = y || aqHeight + 20;
        this.speed = speed || 0.6 + Math.random() * 1.2;
        this.size = size || 3 + Math.random() * 6;
        this.wobble = Math.random() * 100;
        this.wobbleSpeed = 0.02 + Math.random() * 0.03;
      }

      update() {
        this.y -= this.speed;
        this.wobble += this.wobbleSpeed;
        this.x += Math.sin(this.wobble) * 0.25;
      }

      draw() {
        if (aqWidth <= 1 || aqHeight <= 1) return;
        ctx.save();
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
        
        // Shiny liquid glow
        const radGrad = ctx.createRadialGradient(
          this.x - this.size * 0.3, this.y - this.size * 0.3, this.size * 0.1,
          this.x, this.y, this.size
        );
        radGrad.addColorStop(0, 'rgba(255, 255, 255, 0.95)');
        radGrad.addColorStop(0.4, 'rgba(255, 255, 255, 0.25)');
        radGrad.addColorStop(0.8, 'rgba(14, 165, 233, 0.35)');
        radGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');

        ctx.fillStyle = radGrad;
        ctx.fill();
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.5)';
        ctx.lineWidth = 0.5;
        ctx.stroke();
        ctx.restore();
      }
    }

    // Populate initial background aquarium bubbles
    for (let i = 0; i < 12; i++) {
      aqBubbles.push(new AqBubble(null, Math.random() * aqHeight));
    }


    // ==================== AUDIO DESIGN & CODE ====================
    function initSynth() {
      if (audioInitialized) return;
      
      try {
        Tone.start();

        // --- ECO-POLON TAP EFFECT DESIGN ---
        // Delicate, slightly echoed glass/water tap (Polon) - Greatly reduced volume for sleep
        polonDelay = new Tone.FeedbackDelay({
          delayTime: "8n.",
          feedback: 0.35,
          wet: 0.4
        }).toDestination();

        polonSynth = new Tone.PolySynth(Tone.Synth, {
          oscillator: { type: "triangle" },
          envelope: {
            attack: 0.004,
            decay: 0.18,
            sustain: 0,
            release: 0.15
          }
        }).connect(polonDelay);
        polonSynth.volume.value = -12; // Lowered to be extremely gentle

        // --- ORIGINAL FRUTIGER AERO TRACK SYNTHS ---
        // Inspired by Leverfall's "Waiting" - Bright, watery, clean, extremely optimistic
        // Master Ambient BGM Filter to cut out harsh high frequencies (creating a sleep-conducive sound)
        const bgmFilter = new Tone.Filter({
          type: "lowpass",
          frequency: 1000, // Keep it soft, warm, and highly sleep-inducing (no high beeps)
          Q: 1
        }).toDestination();

        // 1. Warm Airy Synth Pad for deep sky backdrop
        faPadSynth = new Tone.PolySynth(Tone.Synth, {
          oscillator: { type: "sine" },
          envelope: {
            attack: 2.2,
            decay: 1.5,
            sustain: 0.75,
            release: 2.5
          }
        }).connect(bgmFilter);
        faPadSynth.volume.value = -10; // Keep the cozy warm pad solid and soft

        // 2. High Shimmering Glass Bell/Pluck - Volume reduced and filtered
        let bellDelay = new Tone.FeedbackDelay("4n", 0.4).connect(bgmFilter);
        faBellSynth = new Tone.PolySynth(Tone.Synth, {
          oscillator: { type: "sine" },
          envelope: {
            attack: 0.05, // Slightly softer attack
            decay: 0.4,
            sustain: 0,
            release: 0.4
          }
        }).connect(bellDelay);
        faBellSynth.volume.value = -20; // Reduced significantly for dreaminess

        // 3. Gentle cascading synth arpeggiator (Triangle/Sine hybrid) - Highly dampened and soft
        let arpDelay = new Tone.FeedbackDelay("16n", 0.25).connect(bgmFilter);
        faArpSynth = new Tone.PolySynth(Tone.Synth, {
          oscillator: { type: "sine" }, // Sine oscillator is much softer and less "picopico" than triangle
          envelope: {
            attack: 0.02,
            decay: 0.08,
            sustain: 0.1,
            release: 0.08
          }
        }).connect(arpDelay);
        faArpSynth.volume.value = -22; // Very faint, flowing like a distant tiny stream

        // 4. Subtle bubble clicker percussive synth
        faTickSynth = new Tone.PolySynth(Tone.Synth, {
          oscillator: { type: "sine" },
          envelope: {
            attack: 0.001,
            decay: 0.015,
            sustain: 0,
            release: 0.01
          }
        }).connect(bgmFilter);
        faTickSynth.volume.value = -24; // Very subtle carbonated crackle

        // --- MASTER SEQUENCER FOR TRACK (112 BPM) ---
        // Optimistic, bright chord progression: Fmaj7 - G6 - Em7 - Am9
        const chords = [
          ["F3", "A3", "C4", "E4"],  // Fmaj7
          ["G3", "B3", "D4", "G4"],  // G6
          ["E3", "G3", "B3", "D4"],  // Em7
          ["A3", "C4", "E4", "G4"]   // Am9
        ];

        // Pentatonic patterns for cascading water droplets / arpeggio
        const arpPatterns = [
          ["C5", "E5", "G5", "C6", "G5", "E5"],
          ["D5", "G5", "B5", "D6", "B5", "G5"],
          ["E5", "G5", "B5", "E6", "B5", "G5"],
          ["C5", "E5", "A5", "C6", "A5", "E5"]
        ];

        let beatCounter = 0;

        faBgmLoop = new Tone.Loop(time => {
          if (isMuted || isLucidDreamActive) return;

          let chordIndex = Math.floor(beatCounter / 16) % chords.length;
          let subBeat = beatCounter % 16; // 16th note counting

          // Play pad chord progression on measure start (every 16 beats)
          if (subBeat === 0) {
            faPadSynth.triggerAttackRelease(chords[chordIndex], "4m", time);
          }

          // Shimmering Bell melodies (Windows Vista optimistic style)
          if (subBeat === 4 || subBeat === 10) {
            let notes = ["C6", "E6", "G6", "A6", "B6"];
            let randomBell = notes[Math.floor(Math.random() * notes.length)];
            faBellSynth.triggerAttackRelease(randomBell, "2n", time);
          }

          // Cascading 16th-note arpeggiator sequence
          let pattern = arpPatterns[chordIndex];
          let noteToPlay = pattern[subBeat % pattern.length];
          faArpSynth.triggerAttackRelease(noteToPlay, "16n", time);

          // Water bubble rhythmic elements (Tick click click)
          if (subBeat % 4 === 0 || subBeat === 14) {
            faTickSynth.triggerAttackRelease("C6", "32n", time);
          }

          beatCounter++;
          
          // Update player duration visually
          let secs = Math.floor(beatCounter * 0.134) % 60; // Approximate counter to seconds
          let playerTimeEl = document.getElementById('playerTime');
          if (playerTimeEl) {
            playerTimeEl.innerText = `0:${secs.toString().padStart(2, '0')} / 0:30`;
          }
        }, "16n");

        Tone.Transport.bpm.value = 112;
        Tone.Transport.start();
        audioInitialized = true;
        
        const audioStatusEl = document.getElementById('audioStatus');
        if (audioStatusEl) audioStatusEl.innerText = "オリジナル環境音: 演奏可能";
        
        // Show successful activation toast
        const toast = document.getElementById('soundLoadAlert');
        if (toast) {
          toast.style.transform = 'translateY(0)';
          toast.style.opacity = '1';
          setTimeout(() => {
            toast.style.opacity = '0';
            toast.style.transform = 'translateY(20px)';
          }, 5000);
        }

      } catch (err) {
        console.warn("Audio initialization suspended.", err);
      }
    }


    // Trigger the Vista Aero sound theme chime
    function playAeroChime() {
      initSynth();
      if (isMuted || !audioInitialized || !faBellSynth) return;
      try {
        const now = Tone.now();
        faBellSynth.triggerAttackRelease("C5", "8n", now);
        faBellSynth.triggerAttackRelease("E5", "8n", now + 0.12);
        faBellSynth.triggerAttackRelease("G5", "8n", now + 0.24);
        faBellSynth.triggerAttackRelease("C6", "2n", now + 0.36);
      } catch (e) {
        console.warn("Chime playback bypassed:", e.message);
      }
    }

    // Trigger echoed "polon" tap sound
    function playPolonChime() {
      initSynth();
      if (isMuted || !audioInitialized || !polonSynth) return;
      try {
        const notes = ["G5", "C6", "E6"];
        const randNote = notes[Math.floor(Math.random() * notes.length)];
        polonSynth.triggerAttackRelease(randNote, "8n", Tone.now());
      } catch (e) {
        console.warn("Polon audio bypassed:", e.message);
      }
    }

    // Track state for generative player
    let isTrackPlaying = false;

    function playMusicTrack() {
      initSynth();
      const playIcon = document.getElementById('playIcon');
      
      if (isTrackPlaying) {
        stopMusicTrack();
        return;
      }

      isTrackPlaying = true;
      if (playIcon) playIcon.className = "fa-solid fa-pause text-xs";
      
      const audioStatusEl = document.getElementById('audioStatus');
      if (audioStatusEl) audioStatusEl.innerText = "環境シンセ曲: 演奏中...";

      if (faBgmLoop) {
        faBgmLoop.start(0);
      }
    }

    function stopMusicTrack() {
      isTrackPlaying = false;
      const playIcon = document.getElementById('playIcon');
      if (playIcon) playIcon.className = "fa-solid fa-play text-xs pl-0.5";
      
      const audioStatusText = document.getElementById('audioStatus');
      if (audioStatusText) audioStatusText.innerText = "演奏停止";
      
      const playerTimeText = document.getElementById('playerTime');
      if (playerTimeText) playerTimeText.innerText = "0:00 / 0:30";
      
      if (faBgmLoop) {
        faBgmLoop.stop();
      }
    }

    function toggleMute() {
      isMuted = !isMuted;
      const icon = document.getElementById('muteIcon');
      if (isMuted) {
        if (icon) icon.className = "fa-solid fa-volume-xmark";
        document.getElementById('muteBtn').classList.add('bg-rose-500/30');
      } else {
        if (icon) icon.className = "fa-solid fa-volume-high";
        document.getElementById('muteBtn').classList.remove('bg-rose-500/30');
        initSynth();
      }
    }


    // ==================== SCREEN TRANSITION HANDLERS ====================
    // Home to Dream Screen
    function enterDream() {
      initDreamAudio();
      
      const home = document.getElementById('homeScreen');
      const game = document.getElementById('gameScreen');
      
      // Fade-out Home, Fade-in Game Simulator
      home.classList.add('opacity-0', 'pointer-events-none', 'scale-95');
      setTimeout(() => {
        home.classList.add('hidden');
        game.classList.remove('hidden');
        // Force Reflow
        game.offsetHeight;
        game.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-10');
        
        // Auto-start full track in game screen
        if (!isTrackPlaying) {
          playMusicTrack();
        }
      }, 500);
    }

    function initDreamAudio() {
      initSynth();
      playAeroChime();
    }

    // Back button event: 1/3 Lucid Dream Nightmare Event Or Go Back
    function handleGoBack() {
      if (isLucidDreamActive) return; // Completely disabled once locked

      initSynth();
      
      // Calculate 1/3 (33.33%) chance
      const randomValue = Math.random();
      if (randomValue < 1/3) {
        // TRAPPED: Only Ending Lucid Dream Event occurs
        isLucidDreamActive = true;
        
        // Stop gorgeous melodic music track
        stopMusicTrack();

        // Silent deep mechanical drone (AC hum / buzz noise is fully removed as requested)
        // Only trigger heavy, quiet low pitch sound without high peaks
        try {
          if (faBgmLoop) faBgmLoop.stop();
          if (faPadSynth) {
            faPadSynth.releaseAll();
            // Soft and quiet low background sound for liminal drone feel
            faPadSynth.triggerAttack(["C2", "G2"], Tone.now());
            faPadSynth.volume.value = -18;
          }
          if (faArpSynth) faArpSynth.releaseAll();
          if (faBellSynth) faBellSynth.releaseAll();
        } catch(e) {
          console.warn(e);
        }

        // Hide all game controls UI, Panels and Header, keeping background
        const header = document.querySelector('header');
        const mainPanel = document.querySelector('main');
        const footer = document.querySelector('footer');
        
        if (header) header.classList.add('transition-all', 'duration-1000', 'opacity-0', 'pointer-events-none');
        if (mainPanel) mainPanel.classList.add('transition-all', 'duration-1000', 'opacity-0', 'pointer-events-none');
        if (footer) footer.classList.add('transition-all', 'duration-1000', 'opacity-0', 'pointer-events-none');

        // Display "No Escape / Lucid Dream" centered text overlay (Static, no pulse)
        const overlay = document.getElementById('noEscapeOverlay');
        if (overlay) {
          overlay.classList.remove('pointer-events-none');
          overlay.classList.add('opacity-100');
        }
        
        // Start spawning upward floating bubbles for the lucid dream state
        startEscapeBubbleSpawner();

      } else {
        // SAFE: Go back to Home Screen
        playAeroChime();
        stopMusicTrack();

        const home = document.getElementById('homeScreen');
        const game = document.getElementById('gameScreen');

        if (game) game.classList.add('opacity-0', 'pointer-events-none', 'translate-y-10');
        setTimeout(() => {
          if (game) game.classList.add('hidden');
          if (home) {
            home.classList.remove('hidden');
            home.offsetHeight;
            home.classList.remove('opacity-0', 'pointer-events-none', 'scale-95');
          }
        }, 800);
      }
    }

    // Dynamic upward escape bubbles generation logic
    function startEscapeBubbleSpawner() {
      const container = document.getElementById('noEscapeBubbleContainer');
      if (!container) return;

      // Spawn a beautiful, soft glass bubble every 350ms indefinitely
      setInterval(() => {
        if (!isLucidDreamActive) return;

        const bubble = document.createElement('div');
        bubble.className = 'escape-bubble';
        
        // Randomize dimensions to match classic vector carbonation bubbles
        const bubbleSize = 10 + Math.random() * 32;
        bubble.style.width = `${bubbleSize}px`;
        bubble.style.height = `${bubbleSize}px`;
        
        // Place horizontally random across full width
        bubble.style.left = `${Math.random() * 100}%`;
        
        // Wobble displacement amount for physics animation
        const wobbleX = (Math.random() - 0.5) * 120;
        bubble.style.setProperty('--wobble-x', `${wobbleX}px`);

        // Randomize floating pace to look organic
        const duration = 7 + Math.random() * 5;
        bubble.style.animationDuration = `${duration}s`;

        container.appendChild(bubble);

        // Cleanup DOM once bubble leaves viewport
        setTimeout(() => {
          bubble.remove();
        }, duration * 1000);
      }, 350);
    }


    // Spawns water droplets that slide down desktop
    function spawnWaterDropletAtWill() {
      const drop = document.createElement('div');
      drop.className = 'water-droplet';
      const dSize = 15 + Math.random() * 25;
      drop.style.width = `${dSize}px`;
      drop.style.height = `${dSize}px`;
      drop.style.left = `${Math.random() * 85 + 5}%`;
      drop.style.top = `-50px`;
      document.body.appendChild(drop);

      // Play echoed polon sound
      playPolonChime();

      // Fluid water gravity physics
      let y = -50;
      let x = parseFloat(drop.style.left) * window.innerWidth / 100;
      let vy = 1 + Math.random() * 2;
      let vx = 0;

      // Drop physics update
      function fall() {
        y += vy;
        vy += 0.05; // gravity
        vx += (Math.random() - 0.5) * 0.15;
        x += vx;

        drop.style.top = `${y}px`;
        drop.style.left = `${x}px`;

        if (y < window.innerHeight - 80) {
          requestAnimationFrame(fall);
        } else {
          // Splat ripple at bottom
          ripple(x, y, 400);
          playPolonChime();
          drop.remove();
        }
      }
      fall();

      // Ripple interact on click
      drop.addEventListener('mousedown', (e) => {
        ripple(e.clientX, e.clientY, 800);
        playPolonChime();
        drop.remove();
      });
    }

    // Spawns falling organic clover/leaves
    function addEcoLeaf() {
      const leaf = document.createElement('div');
      leaf.className = 'absolute pointer-events-auto cursor-pointer z-20 text-emerald-300 drop-shadow-sm transition-all duration-300 hover:scale-125';
      leaf.innerHTML = '<i class="fa-solid fa-leaf"></i>';
      
      const lSize = 14 + Math.random() * 16;
      leaf.style.fontSize = `${lSize}px`;
      leaf.style.left = `${Math.random() * 90}%`;
      leaf.style.top = `-30px`;
      
      const natureContainer = document.getElementById('natureContainer');
      if (natureContainer) natureContainer.appendChild(leaf);

      let y = -30;
      let x = parseFloat(leaf.style.left) * window.innerWidth / 100;
      let rot = Math.random() * 360;
      let rotSpeed = (Math.random() - 0.5) * 2;
      let wobble = Math.random() * 100;

      function glide() {
        y += 1.2 + Math.random() * 0.8;
        wobble += 0.02;
        x += Math.sin(wobble) * 1.5;
        rot += rotSpeed;

        leaf.style.top = `${y}px`;
        leaf.style.left = `${x}px`;
        leaf.style.transform = `rotate(${rot}deg)`;

        if (y < window.innerHeight - 80) {
          requestAnimationFrame(glide);
        } else {
          leaf.style.opacity = '0';
          setTimeout(() => leaf.remove(), 1000);
        }
      }
      glide();

      // Click leaf to transform into hydrogen bubble
      leaf.addEventListener('mousedown', () => {
        const bubble = new AqBubble(x, y, 2.5, lSize/2);
        aqBubbles.push(bubble);
        playPolonChime();
        leaf.remove();
      });
    }

    // Automatic ambient spawns for nostalgic feel
    setInterval(() => {
      const threshold = isLucidDreamActive ? 0.92 : 0.4;
      if (Math.random() > threshold) {
        spawnWaterDropletAtWill();
      }
      if (Math.random() > (isLucidDreamActive ? 0.95 : 0.6)) {
        addEcoLeaf();
      }
    }, 4000);

    // Hydration mist spray animation
    function triggerHydration() {
      initSynth();
      playPolonChime();
      
      // Spawn massive water droplets and ripples
      for (let i = 0; i < 15; i++) {
        setTimeout(() => {
          const rxPos = Math.random() * window.innerWidth;
          const ryPos = Math.random() * window.innerHeight;
          ripple(rxPos, ryPos, 300 + Math.random() * 400);
          
          if (Math.random() > 0.4) {
            spawnWaterDropletAtWill();
          }
        }, i * 150);
      }
    }

    // Spawns interactive pop bubble wave inside Aquarium
    function spawnBubbleWave() {
      initSynth();
      playPolonChime();
      for (let i = 0; i < 20; i++) {
        setTimeout(() => {
          aqBubbles.push(new AqBubble(Math.random() * aqWidth));
        }, i * 100);
      }
    }

    // Boost environmental parameters on clicks
    function boostSystem(type) {
      initSynth();
      playPolonChime();
      if (type === 'solar') {
        solarProgress = Math.min(100, solarProgress + 5);
        const solarBar = document.getElementById('solarBar');
        const solarVal = document.getElementById('solarVal');
        if (solarBar) solarBar.style.width = `${solarProgress}%`;
        if (solarVal) solarVal.innerText = `${solarProgress}%`;
        ripple(window.innerWidth * 0.25, window.innerHeight * 0.4, 600);
      } else if (type === 'bio') {
        bioProgress = Math.min(100, bioProgress + 7);
        const bioBar = document.getElementById('bioBar');
        const bioVal = document.getElementById('bioVal');
        if (bioBar) bioBar.style.width = `${bioProgress}%`;
        if (bioVal) bioVal.innerText = `${bioProgress}%`;
        ripple(window.innerWidth * 0.25, window.innerHeight * 0.6, 600);
        spawnBubbleWave();
      }
    }

    // Plantation simulator
    function feedPlantation() {
      initSynth();
      playPolonChime();
      plantCount += 2;
      const display = document.getElementById('plantCountDisplay');
      if (display) display.innerText = `植物: ${plantCount}株`;
      
      for (let i = 0; i < 6; i++) {
        addEcoLeaf();
      }
    }

    // Add fish simulator
    function addEcofish() {
      initSynth();
      playPolonChime();
      if (fishes.length < 10) {
        fishes.push(new EcoFish());
        const display = document.getElementById('fishCountDisplay');
        if (display) display.innerText = `デジタル魚: ${fishes.length}匹`;
      }
    }


    // Master interaction mapping clicks to the ripple effect canvas & polon sound pop
    window.addEventListener('mousedown', (e) => {
      // Create ripple on the whole background
      ripple(e.clientX, e.clientY, 800);
      initSynth();
      
      // Play echoing polon tap sound
      playPolonChime();
      
      // If clicked inside aquarium area, produce local bubble
      if (aqCanvas) {
        const aqBox = aqCanvas.getBoundingClientRect();
        if (
          e.clientX >= aqBox.left && 
          e.clientX <= aqBox.right && 
          e.clientY >= aqBox.top && 
          e.clientY <= aqBox.bottom
        ) {
          const localX = e.clientX - aqBox.left;
          const localY = e.clientY - aqBox.top;
          aqBubbles.push(new AqBubble(localX, localY, 1.5 + Math.random(), 6 + Math.random() * 6));
        }
      }
    });

    // Master Animation Loop
    function mainLoop() {
      updateRipple();

      if (ctx && aqWidth > 1 && aqHeight > 1) {
        ctx.clearRect(0, 0, aqWidth, aqHeight);
        
        aqBubbles = aqBubbles.filter(b => b.y > -20);
        aqBubbles.forEach(b => {
          b.update();
          b.draw();
        });

        fishes.forEach(f => {
          f.update();
          f.draw();
        });
      }

      requestAnimationFrame(mainLoop);
    }

    // Start on window load
    window.onload = function() {
      mainLoop();
      // Aesthetic initial startup droplets
      setTimeout(() => {
        for(let i=0; i<3; i++) {
          setTimeout(spawnWaterDropletAtWill, i * 600);
        }
      }, 1500);
    }
  </script>
</body>
</html>
